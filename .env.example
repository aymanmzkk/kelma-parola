# Copy this file to ".env" and fill in the values.

# Supabase dashboard -> Project Settings -> Data API (or the "Connect" button) -> Project URL
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase dashboard -> Project Settings -> API Keys -> Publishable key (starts with sb_publishable_)
# On an older project, the legacy "anon" key also works here.
# NEVER put the secret key (sb_secret_...) in this file.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Optional, only for push notifications: the PUBLIC key from "npx web-push generate-vapid-keys"
VITE_VAPID_PUBLIC_KEY=
